// MONGODB_URL
// To get the MongoDB connection URL:
// 1. Sign up on MongoDB Atlas (https://www.mongodb.com/cloud/atlas) if you don't have an account.
// 2. Create a new cluster.
// 3. After the cluster is created, go to the "Connect" tab, choose "Connect your application",
//    and copy the connection string.
// 4. Replace `<password>` with your MongoDB password and `<dbname>` with the name of your database.
below for  local
MONGODB_URL="mongodb://127.0.0.1:27017/Pwa"

// JWT_SECRET_KEY
// This is a secret key used to sign and verify JWT (JSON Web Tokens).
// 1. You can generate it manually or use any random string generator (e.g., https://randomkeygen.com/).
// 2. Ensure the secret key is long and unique (e.g., `32b72e9e254c8aeb2901c8e2d8ed1e0c`).
JWT_SECRET_KEY=

// GOOGLE_CLIENT_SECRET & GOOGLE_CLIENT_ID
// To get the Google API keys:
// 1. Go to the Google Developer Console: https://console.developers.google.com/.
// 2. Create a new project by clicking "Select a Project" and then "New Project".
// 3. Enable the "Google Identity Platform" or "Google OAuth 2.0 API" in the API Library.
// 4. Go to "Credentials", click "Create Credentials", and choose "OAuth Client ID".
// 5. Select "Web application" as the application type, and configure the redirect URIs.
// 6. After creating the credentials, you will see both your "Client ID" and "Client Secret".
// 7. Copy and paste them here.
GOOGLE_CLIENT_SECRET=
GOOGLE_CLIENT_ID=

// BASE_URL
// This is the base URL of your application.
// For example, if your app is hosted at "https://www.example.com", this would be your BASE_URL.
BASE_URL=

// NEXT_PUBLIC_RAZORPAY_KEY_ID & RAZORPAY_SECRET
// To get the Razorpay API keys:
// 1. Go to Razorpay: https://razorpay.com/ and create an account.
// 2. After logging in, go to "Settings" > "API Keys".
// 3. You will find your "Key ID" and "Key Secret" here.
// 4. Copy both and paste them into the environment variables.
NEXT_PUBLIC_RAZORPAY_KEY_ID= 
RAZORPAY_SECRET=

// NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME, NEXT_PUBLIC_CLOUDINARY_API_KEY & NEXT_PUBLIC_CLOUDINARY_API_SECRET
// To get Cloudinary API keys:
// 1. Go to Cloudinary: https://cloudinary.com/ and create an account.
// 2. After logging in, go to "Dashboard" > "Account Settings".
// 3. Here, you will find your "Cloud Name", "API Key", and "API Secret".
// 4. Copy and paste them into the environment variables.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_API_KEY=
NEXT_PUBLIC_CLOUDINARY_API_SECRET=

// AUTH_EMAIL & AUTH_PASSWORD
// AUTH_EMAIL: This is the email address you use to authenticate with your system.
// AUTH_PASSWORD: This is the password for the AUTH_EMAIL.
// If using Google account:
// 1. Go to Google Account Security: https://myaccount.google.com/security.
// 2. Enable "2-Step Verification" under "Signing in to Google".
// 3. Once 2-Step Verification is enabled, go to "App Passwords".
// 4. Select an app and device to generate an app-specific password.
// 5. Use the app-specific password as the AUTH_PASSWORD in your environment variable.
AUTH_EMAIL=
AUTH_PASSWORD=